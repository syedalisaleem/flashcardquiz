<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top bar: Skip button -->
    <TextView
        android:id="@+id/btn_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Skip"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_gravity="top|end"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <!-- Bottom indicator and Next button area -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="48dp"
        android:paddingTop="16dp"
        android:layout_gravity="bottom">

        <!-- Page indicator dots -->
        <LinearLayout
            android:id="@+id/indicator_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dot_0"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="5dp"
                android:src="@drawable/onboarding_indicator"
                android:state_selected="true"
                android:contentDescription="Page 1" />

            <ImageView
                android:id="@+id/dot_1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="5dp"
                android:src="@drawable/onboarding_indicator"
                android:contentDescription="Page 2" />

            <ImageView
                android:id="@+id/dot_2"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="5dp"
                android:src="@drawable/onboarding_indicator"
                android:contentDescription="Page 3" />

            <ImageView
                android:id="@+id/dot_3"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="5dp"
                android:src="@drawable/onboarding_indicator"
                android:contentDescription="Page 4" />
        </LinearLayout>

        <!-- Next button (hidden on last page) -->
        <FrameLayout
            android:id="@+id/btn_next_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/onboarding_card_front"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_onboarding_arrow"
                android:rotation="0"
                android:contentDescription="Next" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
