# OpenAI-compatible endpoint of your choice (OpenRouter, OpenCode Zen, Ollama, ...)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://opencode.ai/zen/v1
LLM_MODEL=deepseek-v4-flash-free
MOCK_LLM=false

# Keyless option (used by docker-compose.yml by default):
#   OPENAI_API_KEY=free
#   OPENAI_BASE_URL=https://text.pollinations.ai/openai
#   LLM_MODEL=openai-fast

# OCR.space API key (free tier: 25K req/month)
# Get yours at https://ocr.space/ocrapi/freekey
OCRSPACE_API_KEY=

# OCR engine: auto (RapidOCR local first, ocr.space fallback) | rapidocr |
# ocrspace | none
OCR_PROVIDER=auto

# Upload ceiling for /api/upload and /api/ocr, in megabytes
MAX_UPLOAD_MB=50

# Extra CORS origins, comma separated (localhost:8000 is always allowed)
CORS_ORIGINS=

# docker-compose only: domain for automatic HTTPS, or :80 for plain HTTP
SITE_ADDRESS=:80

